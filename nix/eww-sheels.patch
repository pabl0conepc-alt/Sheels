         prop(password: as_bool = false) {
             gtk_widget.set_visibility(!password);
+        },
+        // @prop onkeypress - (sheels) command run for Escape/Up/Down/Tab/Page_Up/Page_Down. `{}` is the key name.
+        // @prop timeout - timeout of the command. Default: "200ms"
+        prop(timeout: as_duration = Duration::from_millis(200), onkeypress: as_string) {
